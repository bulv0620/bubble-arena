+import { useRef } from 'react';
+import { useBeforePhysicsStep, useAfterPhysicsStep } from '@react-three/rapier';
+import type { createTrainingSession } from './trainingSession';
+/** TEMPORARY visual QA only: real health damage and interaction rules, fixed AI positions. */
+export function InteractionVisualCheck({session}:{session:ReturnType<typeof createTrainingSession>}){
+ const next=useRef(0),last=useRef('');
+ useBeforePhysicsStep(()=>{
+  if(!session.match.canPlay())return;
+  const tick=session.playerHealth.getTick(),target=session.bots.find(b=>b.seat.slot===0)!;
+  const mode=new URLSearchParams(location.search).get('interaction-check');
+  if(tick>=next.current&&target.getSnapshot().status==='normal'&&!target.getSnapshot().protected){target.receiveCombatDamage(100,session.playerHealth.actor);next.current=tick+180;}
+  if(mode==='kick-fail'&&session.interactions.getSnapshot().kind==='kick'&&(session.interactions.getSnapshot().progress??0)>=.8&&session.playerHealth.getSnapshot().status==='normal')session.playerHealth.receiveCombatDamage(100,target.actor);
+ });
+ useAfterPhysicsStep(()=>{
+  const state=session.interactions.getSnapshot(),fact={tick:session.playerHealth.getTick(),actor:session.playerHealth.getSnapshot().status,target:session.bots.find(b=>b.seat.slot===0)!.getSnapshot().status,locked:session.loadout.getSnapshot().rescuing,kind:state.kind,progress:state.progress,kicks:state.kickSequence,rescues:state.rescues.map(r=>({target:r.targetId,progress:r.progress}))};
+  const key=JSON.stringify({...fact,tick:0,progress:fact.progress===null?null:Math.floor(fact.progress*5),rescues:fact.rescues.map(r=>({...r,progress:Math.floor(r.progress*5)}))});
+  if(key!==last.current){last.current=key;console.info('[4.26.visual]',JSON.stringify(fact));}
+ });
+ return null;
+}
