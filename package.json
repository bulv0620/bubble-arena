{
  "name": "bubble-arena",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "check:workspace": "node scripts/check-workspace.mjs",
    "dev": "pnpm --filter @bubble-arena/web dev",
    "typecheck": "pnpm --filter @bubble-arena/web typecheck && tsc --noEmit -p tsconfig.tools.json",
    "build": "pnpm --filter @bubble-arena/web build",
    "preview": "pnpm --filter @bubble-arena/web preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm check:workspace && pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "4.1.11"
  },
  "type": "module"
}
